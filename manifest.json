{
  "manifest_version": 3,
  "name": "FutureVip WhatsApp Extension",
  "version": "1.0.0",
  "description": "Consulta y opera saldos de Ganamos y MultiPanel desde WhatsApp Web.",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://bo.casinoenvivo.club/*",
    "https://agents.ganamos.net/*",
    "https://wallet.casinoenvivo.club/*",
    "http://127.0.0.1/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/whatsapp.js", "content/bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://bo.casinoenvivo.club/*"],
      "js": ["content/multipanel.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/whatsapp.css"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}